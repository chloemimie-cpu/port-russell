<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Utilisateurs - Port de Russell</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <nav>
      <a href="/dashboard">Tableau de bord</a> |
      <a href="/catways-page">Catways</a> |
      <a href="/reservations-page">Réservations</a> |
      <a href="/users-page">Utilisateurs</a> |
      <a href="/api-docs">Documentation API</a> |
      <a href="/logout">Se déconnecter</a>
    </nav>

    <h1>Gestion des utilisateurs</h1>

    <h2>Créer un utilisateur</h2>
    <form id="createForm">
      <label for="username">Nom</label>
      <input type="text" id="username" required>

      <label for="email">Email</label>
      <input type="email" id="email" required>

      <label for="password">Mot de passe</label>
      <input type="password" id="password" minlength="8" required>

      <button type="submit">Créer</button>
    </form>

    <h2>Liste des utilisateurs</h2>
    <table border="1" cellpadding="8" id="usersTable">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </main>

  <script src="/js/users.js"></script>
</body>
</html>