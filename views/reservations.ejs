<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Réservations - Port de Russell</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <nav>
      <a href="/dashboard">Tableau de bord</a> |
      <a href="/catways-page">Catways</a> |
      <a href="/reservations-page">Réservations</a> |
      <a href="/users-page">Utilisateurs</a> |
      <a href="/api-docs">Documentation API</a> |
      <a href="/logout">Se déconnecter</a>
    </nav>

    <h1>Gestion des réservations</h1>

    <h2>Créer une réservation</h2>
    <form id="createForm">
      <label for="catwayNumber">Numéro du catway</label>
      <input type="number" id="catwayNumber" required>

      <label for="clientName">Client</label>
      <input type="text" id="clientName" required>

      <label for="boatName">Bateau</label>
      <input type="text" id="boatName" required>

      <label for="startDate">Date de début</label>
      <input type="date" id="startDate" required>

      <label for="endDate">Date de fin</label>
      <input type="date" id="endDate" required>

      <button type="submit">Créer</button>
    </form>

    <h2>Liste des réservations</h2>
    <p>Filtrer par numéro de catway : <input type="number" id="filterNumber" placeholder="ex: 1"></p>
    <table border="1" cellpadding="8" id="reservationsTable">
      <thead>
        <tr>
          <th>Catway</th>
          <th>Client</th>
          <th>Bateau</th>
          <th>Début</th>
          <th>Fin</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </main>

  <script src="/js/reservations.js"></script>
</body>
</html>